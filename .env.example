# =============================================================================
# 專案名稱: ai-tools-compose
# 檔案用途: Docker Compose 環境變數範本檔 (.env.example)
# 說明: 請複製本檔案並另存為 `.env`，再根據實際部署需求修改變數內容。
# =============================================================================

# =============================================================================
# 全局與數據持久化配置 (Global & Storage Configuration)
# =============================================================================
# 持久化資料儲存根目錄（相對路徑導向至 ./data）
DATA_DIR=./data

# HuggingFace Token (下載受限模型如 Llama 3 時填寫，預設為空)
HF_TOKEN=''

# GENERIC_TIMEZONE: n8n 排程節點與系統日誌所使用之標準時區
GENERIC_TIMEZONE='Asia/Taipei'

# =============================================================================
# 1. Ollama 大語言模型服務設定
# =============================================================================
# OLLAMA_DOCKER_TAG: 指定 Ollama 容器映像檔標籤 (預設 latest)
OLLAMA_DOCKER_TAG=latest

# OLLAMA_BASE_URL: Open WebUI 連接 Ollama 容器之內部網路位址
OLLAMA_BASE_URL='http://llm-ai-ollama:11434'

# OLLAMA_HOST_PORT: Ollama 對外服務綁定主機埠號 (預設為 11434)
OLLAMA_HOST_PORT=11434

# OLLAMA_DOCKER_PORT: Ollama 對外服務綁定容器埠號 (預設為 11434)
OLLAMA_DOCKER_PORT=11434

# GPU Configuration
# OLLAMA_GPU_DRIVER: 指定 Ollama 容器使用之 GPU 驅動程式 (預設 nvidia)
OLLAMA_GPU_DRIVER=nvidia

# OLLAMA_GPU_COUNT: 指定 Ollama 容器使用之 GPU 數量 (預設 1)
OLLAMA_GPU_COUNT=1

# OLLAMA_ARG_FIT: 指定 Ollama 容器啟動時是否啟用 LLaMA 模型自動調整 (預設 off)
OLLAMA_ARG_FIT=off

# =============================================================================
# 2. Qdrant 向量資料庫設定 (RAG 檢索增強)
# =============================================================================
# VECTOR_DB: 指定向量資料庫類型 (qdrant)
VECTOR_DB=qdrant

# QDRANT_DOCKER_TAG: 指定 Qdrant 容器映像檔標籤 (預設 latest)
QDRANT_DOCKER_TAG=latest

# QDRANT_URI: Qdrant 服務內部連線位址與 REST API 埠號
QDRANT_URI=http://llm-ai-qdrant:6333

# QDRANT_API_KEY: Qdrant 管理員寫入與查詢 API 存取金鑰 (請更換為自訂密碼)
QDRANT_API_KEY=''

# QDRANT_SERVICE_READ_ONLY_API_KEY: Qdrant 唯讀 API 存取金鑰 (請更換為自訂密碼)
QDRANT_SERVICE_READ_ONLY_API_KEY=''

# QDRANT_HTTP_HOST_PORT: Qdrant 對外服務對 REST API 與 Dashboard 控制台綁定主機連線埠號
QDRANT_HTTP_HOST_PORT=6333

# QDRANT_HTTP_DOCKER_PORT: Qdrant 對外服務對 REST API 與 Dashboard 控制台綁定容器連線埠號
QDRANT_HTTP_DOCKER_PORT=6333

# QDRANT_GRPC_HOST_PORT: Qdrant 對外服務對 gRPC 高效傳輸介面綁定主機連線埠號
QDRANT_GRPC_HOST_PORT=6334

# QDRANT_GRPC_DOCKER_PORT: Qdrant 對外服務對 gRPC 高效傳輸介面綁定容器連線埠號
QDRANT_GRPC_DOCKER_PORT=6334

# =============================================================================
# 3. Open WebUI 圖形介面設定
# =============================================================================
# WEBUI_DOCKER_TAG: 指定 Open WebUI 容器映像檔標籤 (預設 main)
WEBUI_DOCKER_TAG=main

# WEBUI_SECRET_KEY: WebUI 後端用於加密 Session 與 Cookie 的金鑰 (請更換為隨機密碼)
WEBUI_SECRET_KEY=''

# ENABLE_SIGNUP: 是否開放新使用者註冊 (False 表示僅允許管理者預建立帳號)
ENABLE_SIGNUP=False

# ENABLE_PERSISTENT_CONFIG: 是否開啟持久化設定 (False 表示優先讀取本 .env 檔設定)
#ENABLE_PERSISTENT_CONFIG=True
ENABLE_PERSISTENT_CONFIG=False 

# OPENAI_API_BASE_URL: OpenAI API 服務位址 (預設為空，使用官方預設)
OPENAI_API_BASE_URL=''

# OPENAI_API_KEY: OpenAI API 存取金鑰 (請填入有效金鑰，若無則留空)
OPENAI_API_KEY=''

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# For production, you should only need one host as
# fastapi serves the svelte-kit built frontend and backend from the same host and port.
# To test with CORS locally, you can set something like
# CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'
# CORS_ALLOW_ORIGIN: 允許跨來源請求的網域清單 (預設為 *，表示允許所有來源)
CORS_ALLOW_ORIGIN='*'

# For production you should set this to match the proxy configuration (127.0.0.1)
FORWARDED_ALLOW_IPS='*'

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# WEBUI_HOST_PORT: Open WebUI 對外服務綁定主機埠號 (預設為 3000)
WEBUI_HOST_PORT=3000

# WEBUI_DOCKER_PORT: Open WebUI 對外服務綁定容器埠號 (預設為 8080)
WEBUI_DOCKER_PORT=8080

# =============================================================================
# 4. PostgreSQL 18 資料庫設定 (n8n 後端存儲)
# =============================================================================
# POSTGRES_USER: PostgreSQL 最高權限管理者帳號
POSTGRES_USER=root

# POSTGRES_PASSWORD: PostgreSQL 最高權限管理者密碼
POSTGRES_PASSWORD=root_passeword

# POSTGRES_DB: PostgreSQL 預設建立之資料庫名稱
POSTGRES_DB=n8n

# POSTGRES_NON_ROOT_USER: 提供給 n8n 使用之專用一般使用者帳號
POSTGRES_NON_ROOT_USER=n8n_user

# POSTGRES_NON_ROOT_PASSWORD: n8n 專用一般使用者密碼
POSTGRES_NON_ROOT_PASSWORD=n8n_user_passeword

# POSTGRES_HOST_PORT: PostgreSQL 對外服務綁定主機埠號 (預設為 5432)
POSTGRES_HOST_PORT=5432

# POSTGRES_DOCKER_PORT: PostgreSQL 對外服務綁定容器埠號 (預設為 5432)
POSTGRES_DOCKER_PORT=5432

# =============================================================================
# 5. n8n 工作流自動化服務設定
# =============================================================================
### n8n configuration
# N8N_DOCKER_TAG: 指定 n8n 容器映像檔標籤 (預設 latest)
N8N_DOCKER_TAG=latest

# N8N_VERSION: n8n 版本號 (stable/latest/0.x.x)
N8N_VERSION=stable

# N8N_NODE_ENV: n8n 執行環境 (production/development)
N8N_NODE_ENV='production'

# N8N_SECURE_COOKIE: 是否啟用安全 Cookie (True 表示僅允許 HTTPS 連線)
N8N_SECURE_COOKIE=false

# N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS: 是否強制檢查設定檔權限 (True 表示僅允許擁有者讀寫) ; 停用嚴格 POSIX 權限檢查以確保 Windows 實體掛載相容性
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=false

# DOMAIN_NAME and SUBDOMAIN together determine where n8n will be reachable from
# N8N_DOMAIN_NAME: n8n 服務綁定主機網域名稱 (本機開發設為 localhost)
N8N_DOMAIN_NAME=localhost

# N8N_SUBDOMAIN: n8n 服務綁定主機子網域名稱 (本機開發設為 n8n)
N8N_SUBDOMAIN=n8n

# N8N_PROTOCOL: n8n 對外服務連線協定 (http/https)
N8N_PROTOCOL=http

# N8N_WEBHOOK_URL: n8n 接收對外 Webhook 回傳呼叫之完整 URL
N8N_WEBHOOK_URL=https://user.example.com/

# N8N_SSL_EMAIL: n8n SSL 憑證申請使用之電子郵件信箱 (用於 Let's Encrypt 申請憑證)
N8N_SSL_EMAIL=user@example.com

# N8N_HOST_PORT: n8n 對外服務綁定主機埠號 (預設為 5678)
N8N_HOST_PORT=5678

# N8N_DOCKER_PORT: n8n 對外服務綁定容器埠號 (預設為 5678)
N8N_DOCKER_PORT=5678

# =============================================================================
# 6. Apache Tika 文件解析伺服器設定
# =============================================================================
# TIKA_SERVER_URL: Open WebUI 調用 Tika 萃取 PDF/DOCX 內文之內部服務位址
# TIKA_DOCKER_TAG: 指定 Tika 容器映像檔標籤 (預設 latest)
TIKA_DOCKER_TAG=latest-full
# TIKA_DOCKER_TAG=3.3.0.0

# TIKA_SERVER_URL: Open WebUI 調用 Tika 萃取 PDF/DOCX 內文之內部服務位址
TIKA_SERVER_URL=http://llm-ai-tika:9998

# TIKA_CHILD_JVM_OPTS: Tika 子進程 JVM 參數設定 (可用於限制記憶體使用量)
TIKA_CHILD_JVM_OPTS=-Xmx4g # 限制 JVM 最大記憶體為 4GB 避免大型文件 OOM

# TIKA_HOST_PORT: Tika 對外服務綁定主機埠號 (預設為 9998)
TIKA_HOST_PORT=9998

# TIKA_DOCKER_PORT: Tika 對外服務綁定容器埠號 (預設為 9998)
TIKA_DOCKER_PORT=9998